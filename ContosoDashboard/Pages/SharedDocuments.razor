@page "/documents/shared"
@using System.Security.Claims
@using ContosoDashboard.Models
@using ContosoDashboard.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IDocumentService DocumentService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Shared with Me - ContosoDashboard</PageTitle>

<div class="container-fluid">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h1>Shared with Me</h1>
        <a class="btn btn-outline-secondary" href="/documents">My Documents</a>
    </div>

    @if (loading)
    {
        <p><em>Loading shared documents...</em></p>
    }
    else if (documents.Count == 0)
    {
        <p class="text-muted">No documents have been shared with you.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr><th>Title</th><th>Category</th><th>Uploader</th><th>Uploaded</th><th>Project</th><th>Actions</th></tr>
                </thead>
                <tbody>
                    @foreach (var document in documents)
                    {
                        <tr>
                            <td>@document.Title</td>
                            <td>@document.Category</td>
                            <td>@document.UploaderName</td>
                            <td>@document.UploadedAtUtc.ToLocalTime().ToString("g")</td>
                            <td>@(document.ProjectName ?? "Personal")</td>
                            <td>
                                <a href="/documents/@document.DocumentId/download">Download</a>
                                @if (document.FileType is "application/pdf" or "image/jpeg" or "image/png")
                                {
                                    <span> · <a href="/documents/@document.DocumentId/preview" target="_blank" rel="noopener">Preview</a></span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<DocumentListItem> documents = [];
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        if (int.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out _))
        {
            documents = (await DocumentService.GetSharedWithMeAsync(user)).ToList();
        }
        loading = false;
    }
}
